generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = "mongodb:ju+@cluster0.9ro3amx.mongodb.net/career"
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  password         String
  email            String    @uque
  name             String
  updatedAt        DateTime  @updatedAt
  role             Role      @default(USER)
}

enum Role {
  USER
  ADMIN
  SUBADMIN
  SUPERADMIN
}
